# Whitelist approach: this directory is a full WordPress install, but only
# project-owned code and docs are tracked. Everything else — WordPress core,
# wp-config.php, uploads, cache, backups, and third-party plugins/themes
# (Elementor, Yoast, LiteSpeed, Hostinger, etc.) — is ignored by default.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.github/
!/AGENTS.md
!/README.md
!/Focused-Schools-Project-Plan.md
!/composer.json
!/composer.lock
!/phpcs.xml.dist
!/docs/

!/wp-content/
/wp-content/*

!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/focused-schools/

!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/focused-schools-core/

# Never commit these, even inside tracked directories.

# Config, secrets, and credentials
wp-config.php
.env
.env.*
auth.json
*.pem
*.key
id_rsa*
id_ed25519*

# Databases and backups
*.wpress
*.sql
*.sql.gz
*.bak
*.zip
*.tar.gz

# Uploads and cache
uploads/
cache/
.phpcs-cache

# Dependencies
vendor/
node_modules/

# OS and logs
*.log
.DS_Store
Thumbs.db
