{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Paper (White)",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Ink (House Teal)",
					"color": "#005c6d"
				},
				{
					"slug": "primary",
					"name": "Coral",
					"color": "#dd6237"
				},
				{
					"slug": "secondary",
					"name": "House Teal",
					"color": "#005c6d"
				},
				{
					"slug": "accent",
					"name": "Cerulean",
					"color": "#0a96cb"
				},
				{
					"slug": "lime",
					"name": "Lime",
					"color": "#a7cc14"
				},
				{
					"slug": "gold",
					"name": "Gold",
					"color": "#f3c145"
				},
				{
					"slug": "raspberry",
					"name": "Raspberry",
					"color": "#bc3e8c"
				},
				{
					"slug": "ink-soft",
					"name": "Ink Soft",
					"color": "#51536a"
				},
				{
					"slug": "paper-soft",
					"name": "Paper Soft",
					"color": "#f5f6f8"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "system",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem"
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "2.25rem"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.5rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "2rem"
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "3rem"
				},
				{
					"slug": "2x-large",
					"name": "2X-Large",
					"size": "4rem"
				}
			],
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--medium)"
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		}
	},
	"custom": {
		"tokenStatus": "approved-2026-rebrand"
	}
}
