{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "focused-schools/story-index",
	"title": "Story Index",
	"category": "design",
	"icon": "grid-view",
	"description": "The filterable grid of impact stories, built live from the records and the migrated legacy pages.",
	"textdomain": "focused-schools",
	"supports": { "html": false, "reusable": false, "multiple": false },
	"attributes": {
		"eyebrow": { "type": "string", "default": "All stories" },
		"heading": { "type": "string", "default": "Browse by state or year." },
		"anchor": { "type": "string", "default": "stories" },
		"perPage": { "type": "number", "default": 9 },
		"emptyText": { "type": "string", "default": "No stories match those filters yet." }
	},
	"editorScript": "focused-schools-blocks-editor",
	"render": "file:./render.php"
}
