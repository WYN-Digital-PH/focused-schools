<?xml version="1.0"?>
<ruleset name="Focused Schools">
    <description>WPCS ruleset for the focused-schools theme and focused-schools-core plugin.</description>

    <file>wp-content/themes/focused-schools</file>
    <file>wp-content/plugins/focused-schools-core</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <!-- WPCS requires >= 3 alphanumeric characters for a registered prefix,
         but this project has used the short "fs_"/"FS_" prefix (2 alnum
         chars) consistently and deliberately across every file since the
         project's first task, for template-local variables (get_template_part()
         args, not true PHP globals) as well as meta keys/CSS classes. Renaming
         that convention project-wide is out of scope for a tooling/lint task,
         so this sniff is excluded rather than producing ~100 false positives
         against an intentional, established convention. Truly global
         constants/functions/classes still use the long-form
         focused_schools_/FocusedSchoolsCore prefixes throughout. -->
    <rule ref="WordPress">
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
    </rule>
    <rule ref="WordPress-Docs"/>

    <!-- Windows checkouts with core.autocrlf=true always show CRLF locally
         regardless of what's actually committed (LF) - this is a per-
         environment checkout artifact, not a real code issue, so don't
         flag it. -->
    <rule ref="Generic.Files.LineEndings">
        <exclude name="Generic.Files.LineEndings.InvalidEOLChar"/>
    </rule>

    <config name="minimum_supported_wp_version" value="6.0"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>

    <!-- WordPress's single-{post_type}.php template hierarchy requires this
         exact filename, underscore included, to match the registered post
         type "fs_impact_story" — renaming it to hyphens would break the
         template entirely. An inline phpcs:ignore comment does not work for
         this sniff (it reports against the filename itself, not a line), so
         this file-specific exclude-pattern is the correct mechanism. -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>*/single-fs_impact_story\.php</exclude-pattern>
    </rule>
</ruleset>
